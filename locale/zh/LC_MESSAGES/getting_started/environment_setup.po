msgid "Dependency Installation"
msgstr ""

#: ../../source/getting_started/environment_setup.md:43
msgid "Dependency Installation Success"
msgstr ""

#: ../../source/getting_started/environment_setup.md:46
msgid ""
"Wait for each component to finish installing. A notification appears in "
"the bottom-right corner when installation is complete."
msgstr ""

