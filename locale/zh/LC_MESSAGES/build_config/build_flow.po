#: ../../source/build_config/build_flow.md:188
msgid "Six Phases"
msgstr "六个阶段"

#: ../../source/build_config/build_flow.md:190
msgid "1. Environment Validation"
msgstr "1. 环境验证"

#: ../../source/build_config/build_flow.md:192
msgid "Verify that the Python virtual environment is activated"
msgstr "验证 Python 虚拟环境已激活"

#: ../../source/build_config/build_flow.md:193
msgid "Verify that West is available and version >= 0.14.0"
msgstr "验证 West 可用且版本 >= 0.14.0"

#: ../../source/build_config/build_flow.md:194
msgid "Verify that `TELINK_TOOLCHAIN_PATH` is set"
msgstr "验证 `TELINK_TOOLCHAIN_PATH` 已设置"

#: ../../source/build_config/build_flow.md:195
msgid "Verify that the toolchain executables are accessible"
msgstr "验证工具链可执行文件可访问"

#: ../../source/build_config/build_flow.md:197
msgid "2. CMake Configuration"
msgstr "2. CMake 配置"

#: ../../source/build_config/build_flow.md:203
msgid ""
"Load and execute all CMake modules (python -> extensions -> west -> "
"compiler -> kconfig -> pinmux -> linker)."
msgstr "加载并执行所有 CMake 模块（python -> extensions -> west -> compiler -> kconfig -> pinmux -> linker）。"

#: ../../source/build_config/build_flow.md:205
msgid "3. Configuration Generation (Config Target)"
msgstr "3. 配置生成（Config 目标）"

#: ../../source/build_config/build_flow.md:211
msgid "Executed in order:"
msgstr "按顺序执行："

#: ../../source/build_config/build_flow.md:212
msgid ""
"Clean old config -> 2. Generate `chip.config` -> 3. Generate "
"`capabilities.h` -> 4. Generate `build.config` -> 5. Merge `.config` -> "
"6. Generate pinmux configuration"
msgstr "清理旧配置 -> 2. 生成 `chip.config` -> 3. 生成 `capabilities.h` -> 4. 生成 `build.config` -> 5. 合并 `.config` -> 6. 生成 pinmux 配置"

#: ../../source/build_config/build_flow.md:214
msgid "4. Source File Compilation"
msgstr "4. 源文件编译"

#: ../../source/build_config/build_flow.md:216
msgid ""
"Ninja compiles all source files concurrently according to `build.ninja` "
"rules."
msgstr "Ninja 根据 `build.ninja` 规则并发编译所有源文件。"

#: ../../source/build_config/build_flow.md:218
msgid "5. Linking"
msgstr "5. 链接"

#: ../../source/build_config/build_flow.md:220
msgid ""
"Link object files into an ELF executable, outputting `.elf`, `.bin`, "
"`.map`."
msgstr "将目标文件链接为 ELF 可执行文件，输出 `.elf`、`.bin`、`.map`。"

#: ../../source/build_config/build_flow.md:222
msgid "6. Firmware Generation"
msgstr "6. 固件生成"

#: ../../source/build_config/build_flow.md:224
msgid "Use `objcopy` to convert ELF to binary `.bin` file"
msgstr "使用 `objcopy` 将 ELF 转换为二进制 `.bin` 文件"

#: ../../source/build_config/build_flow.md:225
msgid "Use `objdump` to generate disassembly for debugging"
msgstr "使用 `objdump` 生成反汇编代码用于调试"

#: ../../source/build_config/build_flow.md:226
msgid "Run `tl_check_fw.sh` to verify firmware"
msgstr "运行 `tl_check_fw.sh` 验证固件"

#: ../../source/build_config/build_flow.md:228
msgid "Configuration Commands"
msgstr "配置命令"

#: ../../source/build_config/build_flow.md:230
msgid "Basic Configuration"
msgstr "基本配置"

#: ../../source/build_config/build_flow.md:236
msgid ""
"This command configures the application in the current directory using "
"default settings."
msgstr "此命令使用默认设置配置当前目录中的应用。"

#: ../../source/build_config/build_flow.md:238
msgid "**Process:**"
msgstr "**流程：**"

#: ../../source/build_config/build_flow.md:239
msgid "Sets up environment variables (TELINK_BASE)"
msgstr "设置环境变量（TELINK_BASE）"

#: ../../source/build_config/build_flow.md:240
msgid "Creates build directory if needed"
msgstr "按需创建构建目录"

#: ../../source/build_config/build_flow.md:241
msgid "Runs initial CMake configuration if required"
msgstr "按需运行初始 CMake 配置"

#: ../../source/build_config/build_flow.md:242
msgid "Executes the unified `config` target which:"
msgstr "执行统一的 `config` 目标，该目标："

#: ../../source/build_config/build_flow.md:243
msgid "Generates `chip.config` from `Kconfig.chip`"
msgstr "从 `Kconfig.chip` 生成 `chip.config`"

#: ../../source/build_config/build_flow.md:244
msgid "Generates `capabilities.h` from chip configuration"
msgstr "从芯片配置生成 `capabilities.h`"

#: ../../source/build_config/build_flow.md:245
msgid "Generates `build.config` from `Kconfig.build`"
msgstr "从 `Kconfig.build` 生成 `build.config`"

#: ../../source/build_config/build_flow.md:246
msgid "Merges configurations into final `.config`"
msgstr "将配置合并为最终的 `.config`"

#: ../../source/build_config/build_flow.md:247
msgid "Generates pinmux configuration files"
msgstr "生成 pinmux 配置文件"

#: ../../source/build_config/build_flow.md:249
msgid "Common Configuration Examples"
msgstr "常见配置示例"

#: ../../source/build_config/build_flow.md:262
msgid "Basic Build Commands"
msgstr "基本构建命令"

#: ../../source/build_config/build_flow.md:269
msgid ""
"This command builds the application in the current directory. If it's the"
" first build, it will automatically configure and build."
msgstr "此命令构建当前目录中的应用。如果是首次构建，将自动进行配置和构建。"

#: ../../source/build_config/build_flow.md:271
msgid "**Pre-build Checks:**"
msgstr "**预构建检查：**"

#: ../../source/build_config/build_flow.md:272
msgid ""
"Checks for existing `.config`, `build.config`, `chip.config`, `pinmux.h`,"
