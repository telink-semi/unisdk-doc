#: ../../source/developing/init_hooks.md:81
#: ../../source/developing/init_hooks.md:101
msgid "**Registration macros:**"
msgstr "**注册宏：**"

#: ../../source/developing/init_hooks.md:62
msgid ""
"`TLK_REGISTER_BEFORE_SUSPEND(fn, level, priority)` → section "
"`.before_suspend_array_<level>_<priority>`"
msgstr ""
"`TLK_REGISTER_BEFORE_SUSPEND(fn, level, priority)` → 段 `.before_suspend_array_<level>_<priority>`"

#: ../../source/developing/init_hooks.md:63
msgid ""
"`TLK_REGISTER_AFTER_SUSPEND(fn, level, priority)` → section "
"`.after_suspend_array_<level>_<priority>`"
msgstr ""
"`TLK_REGISTER_AFTER_SUSPEND(fn, level, priority)` → 段 `.after_suspend_array_<level>_<priority>`"

#: ../../source/developing/init_hooks.md:64
#: ../../source/developing/init_hooks.md:84
msgid "**Invokers:**"
msgstr "**调用器：**"

#: ../../source/developing/init_hooks.md:65
msgid ""
"`void tlk_before_suspend(void)` — calls all registered before-suspend "
"callbacks."
msgstr ""
"`void tlk_before_suspend(void)` — 调用所有已注册的挂起前回调。"

#: ../../source/developing/init_hooks.md:66
msgid ""
"`void tlk_after_suspend(void)` — calls all registered after-suspend "
"callbacks."
msgstr ""
"`void tlk_after_suspend(void)` — 调用所有已注册的挂起后回调。"

#: ../../source/developing/init_hooks.md:76
msgid "Sleep hooks (before / after)"
msgstr "睡眠钩子（之前/之后）"

#: ../../source/developing/init_hooks.md:79
msgid "`typedef void (*tlk_before_sleep_func_t)(void)`"
msgstr "`typedef void (*tlk_before_sleep_func_t)(void)`"

#: ../../source/developing/init_hooks.md:80
msgid "`typedef void (*tlk_after_sleep_func_t)(void)`"
msgstr "`typedef void (*tlk_after_sleep_func_t)(void)`"

