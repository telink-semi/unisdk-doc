#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:19
msgid "Features"
msgstr "功能特性"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:21
msgid ""
"PMP driver - Physical Memory Protection driver for RISC-V privilege "
"enforcement (`feat(pmp)`)"
msgstr ""
"PMP 驱动 - 用于 RISC-V 权限强制的物理内存保护驱动（`feat(pmp)`）"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:22
msgid ""
"User-mode framework - Infrastructure for running untrusted application "
"code in RISC-V User Mode (`feat/user mode`)"
msgstr ""
"用户态框架 - 在 RISC-V 用户模式下运行不可信应用程序代码的基础设施（`feat/user mode`）"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:23
msgid ""
"Cryptography — Hardware crypto acceleration: hash, PKE, SKE, TRNG "
"(`feat(cryptography)`)"
msgstr ""
"加密 — 硬件加密加速：hash、PKE、SKE、TRNG（`feat(cryptography)`）"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:24
msgid ""
"RF fast-settle - Fast RF settling mode for improved RF wake-up latency "
"(`feat(rf): Add the fast settle feature`)"
msgstr ""
"RF 快速稳定 - 快速 RF 稳定模式，改善 RF 唤醒延迟（`feat(rf): Add the fast settle feature`）"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:25
msgid ""
"RF reset functions - New `tlk_rf_reset()` family of functions (`feat(rf):"
" Add the rf reset functions`)"
msgstr ""
"RF 复位函数 - 新增 `tlk_rf_reset()` 函数系列（`feat(rf): Add the rf reset functions`）"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:26
msgid ""
"RF mode-switching demo - Sample demonstrating dynamic RF mode changes "
"(`feat(rf): Add the mode switching demo`)"
msgstr ""
"RF 模式切换示例 - 演示动态 RF 模式切换的示例（`feat(rf): Add the mode switching demo`）"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:27
msgid ""
"Legacy toolchain env var - `TELINK_BASE_SDK` environment variable alias "
"for backward compatibility (`feat(toolchain)`)"
msgstr ""
"旧版工具链环境变量 - 用于向后兼容的 `TELINK_BASE_SDK` 环境变量别名（`feat(toolchain)`）"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:28
msgid ""
"IRQ nesting - Updated interrupt controller code supporting interrupt "
"preemption (`feat(IRQ code)`)"
msgstr ""
"IRQ 嵌套 - 更新的中断控制器代码，支持中断抢占（`feat(IRQ code)`）"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:29
msgid ""
"USB Universal API - Comprehensive USB driver with unified access "
"interface and TinyUSB integration layer"
msgstr ""
"USB 通用 API - 全面的 USB 驱动，具有统一访问接口和 TinyUSB 集成层"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:30
msgid ""
"I2C Universal API - Complete I2C driver with unified driver structure for"
" all MCUs"
msgstr ""
"I2C 通用 API - 完整的 I2C 驱动，为所有 MCU 提供统一的驱动结构"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:31
msgid ""
"SPI Universal API - SPI driver with Master support and Unified APIs for "
"all supported SOCs"
msgstr ""
"SPI 通用 API - 支持主模式并为所有支持的 SoC 提供统一 API 的 SPI 驱动"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:32
msgid "Power API - Power-rail control API (`tlk_power.h`)"
msgstr "电源 API - 电源轨控制 API（`tlk_power.h`）"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:33
msgid "DMA API - Expanded DMA driver with unified dynamic configuration"
msgstr "DMA API - 扩展的 DMA 驱动，支持统一动态配置"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:34
msgid ""
"PLIC API - Unified Interrupt controller with common API for all supported"
" SOCs"
msgstr "PLIC API - 统一的中断控制器，为所有支持的 SoC 提供通用 API"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:35
msgid "ADC API - Unified ADC API for all supported SOCs"
msgstr "ADC API - 为所有支持的 SoC 提供统一的 ADC API"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:36
msgid ""
"mbedTLS module - PSA Crypto API integration with hardware TRNG "
"acceleration"
msgstr "mbedTLS 模块 - PSA Crypto API 集成，支持硬件 TRNG 加速"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:37
msgid ""
"Logger subsystem - Debug Log for simplifying the user experience with "
"formatting and sending the debug messages"
msgstr ""
"日志子系统 - 调试日志，简化格式化与发送调试消息的用户体验"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:38
msgid "Multi-level init system - Support for different system init levels"
msgstr "多级初始化系统 - 支持不同的系统初始化级别"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:39
msgid ""
"Task planner and loops - Simple multi-task queue with multi-threading or "
"serial execution"
msgstr "任务规划器和循环 - 简单的多任务队列，支持多线程或串行执行"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:40
msgid "Software timer - Mtimer based multi-instance software timer"
msgstr "软件定时器 - 基于 Mtimer 的多实例软件定时器"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:41
msgid ""
"Storage system - Abstract storage device layer with SOC flash driver "
"support"
msgstr "存储系统 - 抽象存储设备层，支持 SoC Flash 驱动"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:42
msgid "Debug system - Assert handling and GPIO debug support"
msgstr "调试系统 - 断言处理和 GPIO 调试支持"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:43
msgid ""
"Dynamic memory management - Configurable heap allocation with retention "
"memory support"
msgstr "动态内存管理 - 可配置的堆分配，支持保持内存"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:44
msgid ""
"Pinmux configuration tool - Interactive Python TUI for visual pin "
"multiplexing configuration"
msgstr "Pinmux 配置工具 - 用于可视化引脚复用配置的交互式 Python TUI"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:45
msgid ""
"Toolchain auto-discovery - Automatic RISC-V GCC toolchain path detection "
"and validation"
msgstr "工具链自动发现 - 自动检测和验证 RISC-V GCC 工具链路径"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:46
msgid ""
"Zephyr module integration - UniSDK as a standard Zephyr RTOS module "
"(`module.yml`) with CMake/Kconfig bridge"
msgstr "Zephyr 模块集成 - UniSDK 作为标准 Zephyr RTOS 模块（`module.yml`），带有 CMake/Kconfig 桥接"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:47
msgid ""
"Zephyr Kconfig bridge - SoC/Core/Board mapping from Zephyr to UniSDK "
"(`CONFIG_SOC_SERIES_TELINK_*` → `CONFIG_TLK_CORE/SOC/BOARD`)"
msgstr "Zephyr Kconfig 桥接 - 从 Zephyr 到 UniSDK 的 SoC/Core/Board 映射（`CONFIG_SOC_SERIES_TELINK_*` → `CONFIG_TLK_CORE/SOC/BOARD`）"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:48
msgid "Subsystem"
msgstr "子系统"

#: ../../source/releases/0.2.0/Unified_SDK_Release_Note.md:49
msgid ""
"BLE Controller - Complete BLE Link Layer with HCI, LL, ACL, Advertising, "
"and Scanning support"
msgstr "BLE Controller - 完整的 BLE 链路层，支持 HCI、LL、ACL、广播和扫描"

