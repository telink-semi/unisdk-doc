msgid "Before/After sleep hook functions"
msgstr "睡眠前/后钩子函数"

#: ../../source/samples/pm.md:17
msgid "Variable retention across Deep Sleep Retention mode"
msgstr "深度睡眠保持模式下的变量保持"

